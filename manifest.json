{
  "manifest_version": 3,
  "name": "Дубли вкладок",
  "version": "1.1.0",
  "description": "Находит одинаковые вкладки во всех окнах Chrome и помогает закрыть лишние.",
  "permissions": ["tabs", "storage"],
  "incognito": "split",
  "icons": {
    "16": "icons/tabs-16.png",
    "32": "icons/tabs-32.png",
    "48": "icons/tabs-48.png",
    "128": "icons/tabs-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/tabs-16.png",
      "32": "icons/tabs-32.png"
    },
    "default_title": "Найти дубли вкладок"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
